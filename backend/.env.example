# Copy this file to backend/.env and replace the placeholder values.
# Never commit the real backend/.env file.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prices_indicator

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Separate server secret used to HMAC-hash OTPs. Must differ from JWT_SECRET_KEY.
OTP_HMAC_SECRET=replace-with-a-long-random-secret

# Google Sign-In web client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email delivery. EMAIL_PROVIDER selects exactly one of: smtp | brevo | resend | gmail_api
EMAIL_PROVIDER=smtp

# --- SMTP (Gmail uses smtp.gmail.com:587 STARTTLS or :465 SSL) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Prices Indicator

# --- Brevo HTTPS API ---
BREVO_API_KEY=xkeysib-xxxxxxxxx
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Prices Indicator

# --- Gmail API over HTTPS (separate OAuth client from GOOGLE_CLIENT_ID) ---
# Authorize the sender account once to obtain GMAIL_API_REFRESH_TOKEN.
# See backend/authorize_gmail.py for the exact steps. The client ID/secret
# and refresh token live on the backend only and are never sent to the
# frontend.
GMAIL_API_CLIENT_ID=xxxxxxxxx.apps.googleusercontent.com
GMAIL_API_CLIENT_SECRET=xxxxxxxxx
GMAIL_API_REFRESH_TOKEN=1//xxxxxxxxx
GMAIL_API_SENDER_EMAIL=you@example.com
GMAIL_API_SENDER_NAME=Prices Indicator

# --- Resend HTTPS API ---
RESEND_API_KEY=re_xxxxxxxxx
# The testing sender only delivers to the Resend account owner's email.
# To send to arbitrary recipients, verify a domain at https://resend.com/domains
# and use an address on that verified domain here.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Prices Indicator

# Comma-separated admin account emails
ADMIN_EMAILS=admin@example.com

# Minimum seconds between OTP resend requests
OTP_RESEND_COOLDOWN_SECONDS=30
